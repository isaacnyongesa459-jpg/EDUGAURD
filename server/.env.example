NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://eduguard:change-me@localhost:5432/eduguard
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL=8h
COOKIE_NAME=eduguard_session
# Local HTTP development: Secure=false and SameSite=Lax work on localhost.
# HTTPS cross-site Preview embedding may require COOKIE_SECURE=true and SameSite=None.
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=eduguard_csrf
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=0
BCRYPT_ROUNDS=12
ENROLLMENT_TTL_MINUTES=30
